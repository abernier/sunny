{
  "name": "sunny-tray",
  "productName": "Sunny",
  "version": "0.1.0",
  "description": "A macOS menu-bar app that controls the luminosity-boost brightness tool",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:page": "vite",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "check": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "icon": "node scripts/icon.mjs",
    "app-icon": "node scripts/app-icon.mjs",
    "pack": "node scripts/pack.mjs",
    "dist": "node scripts/pack.mjs --dmg"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
