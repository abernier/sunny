<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store app itself (pnpm mas). Sandboxed, with no network and no file access
     beyond its container. The application group is what Electron's processes meet through under the sandbox;
     the identifiers match the provisioning profile (app ID Z9273KN92X.com.abernier.sunny). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>Z9273KN92X.com.abernier.sunny</string>
	</array>
	<key>com.apple.application-identifier</key>
	<string>Z9273KN92X.com.abernier.sunny</string>
	<key>com.apple.developer.team-identifier</key>
	<string>Z9273KN92X</string>
</dict>
</plist>
