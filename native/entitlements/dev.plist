<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The development build (scripts/build.sh dev): signed ad hoc, sandboxed like the store build so that it
     runs under the same rules. The identifiers of mas.plist need a provisioning profile, so they are left out. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
