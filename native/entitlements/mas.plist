<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store app (scripts/build.sh mas). Sandboxed, with no network and no file access beyond
     its container. The identifiers match the provisioning profile (app ID Z9273KN92X.com.abernier.sunny).
     No application group: that was for Electron's processes, and this app is a single process. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>Z9273KN92X.com.abernier.sunny</string>
	<key>com.apple.developer.team-identifier</key>
	<string>Z9273KN92X</string>
</dict>
</plist>
